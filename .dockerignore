# Keep the Docker build context small and reproducible.
target
.git
.gitignore
output
vision
assets
docs
scripts
# NOT `skills`: webrain-core include_str!s skills/webrain/** into the binary, so
# excluding it turned every `docker build` into a 16-error compile failure.
*.md
.github
# Secrets: keep keys/credentials out of the build context (COPY . . ships it
# to the builder image layers / cache).
.env*
*.pem
*.key
*.p12
id_rsa*
credentials*
